--- sound/soc/qcom/qdsp6/q6afe.c	2026-11-13 18:18:33.975568019 +0800
+++ sound/soc/qcom/qdsp6/q6afe.c	2026-11-13 18:39:51.102489660 +0800
@@ -1733,6 +1733,7 @@
 {
 	struct q6afe *afe;
 	struct device *dev = &adev->dev;
+	unsigned long timeout;
 
 	afe = devm_kzalloc(dev, sizeof(*afe), GFP_KERNEL);
 	if (!afe)
@@ -1748,6 +1749,22 @@
 
 	dev_set_drvdata(dev, afe);
 
+	/*
+	 * Wait for the DSP audio services to come up before creating ports
+	 * and the clock controller (Nova-Deck issue #94: probing too early
+	 * makes the ADSP reject LPASS core HW votes with 0x16, which then
+	 * leaves the LPI pinctrl driver without its clocks).
+	 */
+	timeout = jiffies + msecs_to_jiffies(10000);
+	while (!q6core_is_adsp_ready()) {
+		if (time_after(jiffies, timeout)) {
+			dev_err(dev, "DSP audio services not ready, deferring probe\n");
+			return -EPROBE_DEFER;
+		}
+		msleep(50);
+	}
+	dev_info(dev, "DSP audio services ready\n");
+
 	return devm_of_platform_populate(dev);
 }
 
