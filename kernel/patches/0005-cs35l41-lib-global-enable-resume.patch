--- a/sound/soc/codecs/cs35l41-lib.c	2026-11-14 17:39:05.122633998 +0800
+++ b/sound/soc/codecs/cs35l41-lib.c	2026-11-14 17:39:05.123393702 +0800
@@ -1283,11 +1283,25 @@
 			return ret;
 		}
 
-		ret = regmap_read_poll_timeout(regmap, CS35L41_IRQ1_STATUS1,
-					int_status, int_status & pup_pdn_mask,
-					1000, 100000);
-		if (ret)
-			dev_err(dev, "Enable(%d) failed: %d\n", enable, ret);
+		/*
+		 * Xiaomi alioth CS35L41 B2 + spk-prot firmware never raises
+		 * PUP_DONE/PDN_DONE (power-up shows as IRQ1_STATUS1 bit 22).
+		 * The firmware boots PAUSED; RESUME makes it raise AMP_EN and
+		 * the boost itself (hakios-alioth proven sequence).  Do not
+		 * poll the done bits here - that only causes a false -ETIMEDOUT
+		 * which rolls the whole DAPM chain back down.
+		 */
+		if (dsp->running) {
+			if (enable)
+				ret = cs35l41_set_cspl_mbox_cmd(dev, regmap,
+								CSPL_MBOX_CMD_RESUME);
+			else
+				ret = cs35l41_set_cspl_mbox_cmd(dev, regmap,
+								CSPL_MBOX_CMD_PAUSE);
+			if (ret)
+				dev_err(dev, "AMP mbox %s failed: %d\n",
+					enable ? "RESUME" : "PAUSE", ret);
+		}
 
 		/* Clear PUP/PDN status */
 		regmap_write(regmap, CS35L41_IRQ1_STATUS1, pup_pdn_mask);
