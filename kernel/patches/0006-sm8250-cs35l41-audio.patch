+/*
+ * The TERT MI2S speaker backend is fixed at 48 kHz / 16-bit / stereo I2S.
+ * The q6asm frontend advertises up to 8 channels, so PipeWire picks an
+ * 8-channel s24-32le sink, which then never matches the hardware path and
+ * also makes hardware volume control meaningless. Pin the frontend to the
+ * real stream format instead of advertising capability the backend lacks.
+ */
+static int sm8250_fe_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *rtd_runtime = substream->runtime;
+	int ret;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+
+	ret = snd_pcm_hw_constraint_minmax(rtd_runtime,
+					   SNDRV_PCM_HW_PARAM_CHANNELS, 2, 2);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_minmax(rtd_runtime,
+					   SNDRV_PCM_HW_PARAM_RATE, 48000, 48000);
+	if (ret < 0)
+		return ret;
+	return snd_pcm_hw_constraint_mask64(rtd_runtime,
+					    SNDRV_PCM_HW_PARAM_FORMAT,
+					    SNDRV_PCM_FMTBIT_S16_LE);
+}
+
+static const struct snd_soc_ops sm8250_fe_ops = {
+	.startup = sm8250_fe_startup,
+};
