 #define DRIVER_NAME		"sm8250"
 #define MI2S_BCLK_RATE		1536000
 #define TDM_BCLK_RATE		12288000
+/* Vendor DTBO: QUAT TDM BCLK = 0x177000 (1536000), not 12.288MHz */
+#define QUAT_TDM_BCLK_RATE	1536000
 
 static unsigned int tdm_slot_offset[8] = {0, 4, 8, 12, 16, 20, 24, 28};
 
+/* QUAT TDM experiments (hot-tunable, applied on top of vendor-mirror config) */
+static int exp_tdm_rate = QUAT_TDM_BCLK_RATE;
+module_param(exp_tdm_rate, int, 0644);
+MODULE_PARM_DESC(exp_tdm_rate, "QUAD_TDM_IBIT vote rate (default 1536000 per vendor DTBO)");
+static int exp_tdm_attr;	/* 0=INVERT(default per upstream) 1=COUPLE_NO */
+module_param(exp_tdm_attr, int, 0644);
+MODULE_PARM_DESC(exp_tdm_attr, "QUAD_TDM_IBIT vote attr: 0=INVERT_COUPLE_NO 1=COUPLE_NO");
+
+static uint32_t exp_core_handles[2];
+static bool exp_core_voted;
+
+static void sm8250_exp_tdm_vote(struct snd_soc_pcm_runtime *rtd,
+				struct snd_soc_dai *cpu_dai)
+{
+	struct q6afe_port *port;
+	int attr = exp_tdm_attr ? Q6AFE_LPASS_CLK_ATTRIBUTE_COUPLE_NO
+				: Q6AFE_LPASS_CLK_ATTRIBUTE_INVERT_COUPLE_NO;
+	int ret;
+
+	port = q6afe_port_get_from_id(cpu_dai->dev, QUATERNARY_TDM_RX_0);
+	if (IS_ERR(port)) {
+		dev_err(rtd->dev, "exp: quat tdm port get failed %ld\n", PTR_ERR(port));
+		return;
+	}
+	ret = q6afe_port_set_sysclk(port, Q6AFE_LPASS_CLK_ID_QUAD_TDM_IBIT,
+				    attr, 0, exp_tdm_rate,
+				    SNDRV_PCM_STREAM_PLAYBACK);
+	dev_info(rtd->dev, "exp: QUAD_TDM_IBIT vote attr=%d rate=%d ret=%d\n",
+		 attr, exp_tdm_rate, ret);
+	/* keep the DAI's refcount; port stays open for the stream */
+}
+
+static void sm8250_exp_tdm_cleanup(struct device *dev)
+{
+	if (exp_core_voted) {
+		q6afe_unvote_lpass_core_hw(dev, Q6AFE_LPASS_CORE_HW_MACRO_BLOCK,
+					   exp_core_handles[0]);
+		q6afe_unvote_lpass_core_hw(dev, Q6AFE_LPASS_CORE_HW_DCODEC_BLOCK,
+					   exp_core_handles[1]);
+		exp_core_voted = false;
+	}
+}
+
