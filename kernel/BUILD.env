# --- Redmi K40 / POCO F3 (alioth) kernel source ------------------------------
# Armada's alioth variant uses the community mainline tree that carries the
# sm8250-xiaomi-alioth board support: Samsung AMS667XX01 (k11a) DSC panel,
# FocalTech FT8756 SPI touchscreen, WCD938x + 2x CS35L41 audio, PM8150 fuel
# gauge, QCA6390 WiFi/BT, SDX55 modem (unused).
#
# Plan B (device-validated baseline): the nikroks/alioth branch is 6.15.1,
# the EXACT kernel the target device already runs successfully (Arch Linux
# ARM, 6.15.1-aliothml+). alioth.config is vendored from that device's
# /proc/config.gz so the boot-critical drivers (DRM_MSM, the ams667xx01 panel,
# FT8756 touch, PM8008 regulators) stay built-in exactly as validated. The
# Armada runtime fragment is merged on top.
#
# KERNEL_SRC (optional): build from a local checkout instead of cloning.
KERNEL_REPO=https://github.com/mainlining/linux.git
KERNEL_BRANCH=nikroks/alioth
KERNEL_CONFIG=alioth.config

# Armada runtime fragment merged on top of the alioth base config.
KERNEL_OVERRIDES="alioth-armada.config.overrides"
