# Armada runtime fragment merged on top of the alioth board config
# (kernel-alioth/alioth.config, vendored from the device's /proc/config.gz)
# by kernel-alioth/build.sh.
#
# The build script filters the fragment: only symbols the base config already
# defines are merged as-is; the rest are pre-set via scripts/config and kept
# by olddefconfig when a Kconfig entry backs them. So adding an option here
# never breaks the merge.
#
# The alioth base config already turns on the boot-critical device drivers
# built-in (DRM_MSM, DRM_PANEL_SAMSUNG_AMS667XX01, TOUCHSCREEN_FT8756,
# MFD/REGULATOR_QCOM_PM8008, ath11k QCA6390, hci_qca BT, USB configfs
# RNDIS/ECM/NCM); what it lacks is Armada's runtime (game stack, FEX,
# SELinux, zram tuning, nftables) and a few gaming/perf options.

# ============== Stable KVER ==============
# Base sets LOCALVERSION "-aliothml"; give Armada builds a distinct, stable
# suffix. CONFIG_LOCALVERSION_AUTO=n is already in the base; the transferred
# tree has no .git so setlocalversion adds no "+" either.
CONFIG_LOCALVERSION="-armada"

# ============== Armada runtime (game stack + FEX) ==============
# BINFMT_MISC=m is already in the base config (FEX registration).
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=m                       # squashfs/fuse payloads
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_CIFS=m
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS_ZSTD=y
# Root is plain ext4 (container export); btrfs stays available as a module.
CONFIG_BTRFS_FS=m

# ============== bootc / ostree / systemd ==============
CONFIG_FANOTIFY=y                       # ostree file-change tracking
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y               # hard dep of SECURITY_SELINUX
CONFIG_SECURITY_SELINUX=y               # base has SELinux off; Armada runs permissive
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# SYSFB_SIMPLEFB / FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER stay OFF: deferred
# takeover blanks fbcon until userspace writes, hiding early-boot panics.
CONFIG_RD_ZSTD=y

# ============== Waydroid ==============
CONFIG_ANDROID_BINDER_IPC=y             # already in the base config
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y                             # lmkd memory-pressure monitoring
CONFIG_PSI_DEFAULT_DISABLED=y            # opt in with psi=1
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_XFRM_USER=y

# ============== Gaming performance ==============
# sched_ext needs BPF_SYSCALL + DEBUG_INFO_BTF (pahole). We enable BPF but do
# NOT force DEBUG_INFO_BTF here (it would add a pahole build dependency); if
# the base lacks BTF, SCHED_CLASS_EXT stays off and scx falls back to CFS.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_UCLAMP_TASK=y                     # armada-powerd cpu.uclamp.min per game
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_NTSYNC=y                          # Proton NT sync; off in the base config
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Base uses THP ALWAYS which bloats FEX RAM; switch to MADVISE.
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# ============== HID / gamepads (external controllers via Bluetooth/USB) ====
CONFIG_INPUT_UINPUT=y                    # base has =m; Armada wants built-in
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_STEAM=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
# alioth: the telescopic controller only registers in XInput mode, which needs
# xpad. Without it the pad is dead in "Xbox" mode while "PS" mode works via
# HID_SONY -- the exact symptom on this device.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# ============== Device drivers (keep built-in as validated) ==============
CONFIG_TOUCHSCREEN_FT8756=y              # FocalTech FT8756 SPI touch (spi4.0)
CONFIG_DRM_PANEL_SAMSUNG_AMS667XX01=y    # Samsung E4 (k11a) DSC panel

# ============== WiFi / Bluetooth (QCA6390) ==============
# Base already enables these; restate to be explicit.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_MHI_BUS=m
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_BT=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
CONFIG_SERIAL_DEV_BUS=y

# ============== USB gadget network (sshd over RNDIS/ECM) ==============
# Base already has configfs RNDIS/ECM/NCM; restate the two Armada needs.
CONFIG_USB_CONFIGFS_F_RNDIS=y
CONFIG_USB_CONFIGFS_F_ECM=y

# ============== Compressed firmware (Fedora/RPM qcom fw is .xz-only) ======
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ============== ZRAM ==============
CONFIG_ZSMALLOC=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_CRYPTO_ZSTD=y

# ============== netfilter / nftables (firewalld, Tailscale, WireGuard) =====
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_WIREGUARD=m
